# Copy to .env with:  ./scripts/gen-env.sh   (generates all secrets for you)
# NEVER commit .env.

# ---- Image ----
AIRFLOW_VERSION=3.3.1
PYTHON_VERSION=3.12
AIRFLOW_IMAGE=shorthills/airflow
# Linux: set to `id -u` so bind-mounted files are owned by you. macOS/Windows: keep 50000.
AIRFLOW_UID=50000

# ---- Postgres (metadata DB) ----
POSTGRES_USER=airflow
POSTGRES_DB=airflow
POSTGRES_PASSWORD=CHANGE_ME_hex_only

# ---- Redis (Celery broker) ----
REDIS_PASSWORD=CHANGE_ME_hex_only

# ---- Airflow secrets ----
AIRFLOW_FERNET_KEY=CHANGE_ME
AIRFLOW_API_SECRET_KEY=CHANGE_ME
AIRFLOW_JWT_SECRET=CHANGE_ME

# ---- Admin user (created on first init) ----
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---- Network / URL ----
# 127.0.0.1 keeps the UI off the public interface; put a TLS proxy or LB in front.
AIRFLOW_API_BIND=127.0.0.1
AIRFLOW_BASE_URL=http://localhost:8080

# ---- Sizing (tuned for a MacBook with Docker Desktop at 8 GB RAM / 4 CPUs) ----
# Total memory caps below add up to about 6.8 GB, leaving headroom inside an 8 GB VM.
AIRFLOW_WORKER_REPLICAS=1
AIRFLOW_WORKER_CONCURRENCY=4
AIRFLOW_PARALLELISM=8
AIRFLOW_API_WORKERS=1
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
APISERVER_MEM_LIMIT=1536m
SCHEDULER_MEM_LIMIT=1g
DAG_PROCESSOR_MEM_LIMIT=1g
TRIGGERER_MEM_LIMIT=768m
WORKER_MEM_LIMIT=1536m

# ---- Flower (profile: flower) ----
FLOWER_BASIC_AUTH=admin:CHANGE_ME
